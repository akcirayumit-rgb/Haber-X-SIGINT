{
  "name": "haber-x-sigint",
  "version": "1.0.0",
  "description": "Haber-X SIGINT — Sinyal İstihbarat Konsolu",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "node server.js",
    "build": "electron-builder --mac"
  },
  "dependencies": {
    "axios": "^1.17.0",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^42.3.2",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.haberx.sigint",
    "productName": "Haber X-SIGINT",
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities"
    },
    "extraResources": [
      {
        "from": "server.js",
        "to": "server.js"
      },
      {
        "from": "index.html",
        "to": "index.html"
      },
      {
        "from": "whisper_service.py",
        "to": "whisper_service.py"
      },
      {
        "from": "whisper_service_file.py",
        "to": "whisper_service_file.py"
      },
      {
        "from": "decoder-manager.js",
        "to": "decoder-manager.js"
      },
      {
        "from": "test-decoders",
        "to": "test-decoders"
      }
    ],
    "files": [
      "main.js",
      "node_modules/**/*"
    ]
  }
}
